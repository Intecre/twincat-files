<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.25">
  <POU Name="T_CsvFileWriter_Tests" Id="{c0427a26-e5db-4f74-9bdc-e6060488ce8b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK T_CsvFileWriter_Tests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Test_SeparatesFieldsWithCommas();
Test_SeparatesFieldsWithSemicolons();
Test_UnknownSeparatorFallsBackToSemicolon();
Test_AppendModeAddsRows();
Test_QuotesAFieldContainingTheSeparator();
Test_CountsRowsAndColumns();
Test_ClearBufferReportsTheBufferIsClear();
]]></ST>
    </Implementation>
    <Method Name="Test_SeparatesFieldsWithCommas" Id="{155abe5e-6771-4b33-a491-2252c57ed91b}">
      <Declaration><![CDATA[METHOD PRIVATE Test_SeparatesFieldsWithCommas
VAR_INST
  writer : T_CsvFileWriter;
  testFile : T_TestFile;
  timeout : TON;
  step : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT TcUnit.TEST_ORDERED(__POUNAME()) THEN
  RETURN;
END_IF

writer();
testFile();

timeout(IN := TRUE, PT := TestFiles.TIMEOUT);

IF timeout.Q THEN
  AssertTrue(Condition := FALSE, Message := 'the file operation did not finish in time');
  TEST_FINISHED_NAMED(__POUNAME());
  RETURN;
END_IF

CASE step OF

  0:

    writer.SetFileParams(FilePath := F_TestFilePath('csv_commas.csv'), Separator := ASCI_COMMA);
    writer.AddStringField(sFieldString := 'a');
    writer.AddStringField(sFieldString := 'b');
    writer.NewLine();
    writer.AddStringField(sFieldString := 'c');
    writer.AddStringField(sFieldString := 'd');
    writer.WriteToFile();
    step := 10;

  10:

    IF writer.Busy THEN
      RETURN;
    END_IF

    AssertFalse(Condition := writer.Error, Message := 'file written without an error');
    testFile.Read(FilePath := F_TestFilePath('csv_commas.csv'));
    step := 20;

  20:

    IF testFile.Busy THEN
      RETURN;
    END_IF

    AssertEquals_STRING(Expected := 'a,b$R$Nc,d$R$N', Actual := testFile.Text, Message := 'two rows of two comma separated fields');
    TEST_FINISHED_NAMED(__POUNAME());

END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_SeparatesFieldsWithSemicolons" Id="{8d19dac8-8109-45f7-b680-af99d283d90a}">
      <Declaration><![CDATA[METHOD PRIVATE Test_SeparatesFieldsWithSemicolons
VAR_INST
  writer : T_CsvFileWriter;
  testFile : T_TestFile;
  timeout : TON;
  step : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT TcUnit.TEST_ORDERED(__POUNAME()) THEN
  RETURN;
END_IF

writer();
testFile();

timeout(IN := TRUE, PT := TestFiles.TIMEOUT);

IF timeout.Q THEN
  AssertTrue(Condition := FALSE, Message := 'the file operation did not finish in time');
  TEST_FINISHED_NAMED(__POUNAME());
  RETURN;
END_IF

CASE step OF

  0:

    writer.SetFileParams(FilePath := F_TestFilePath('csv_semicolons.csv'), Separator := ASCI_SEMI_COLON);
    writer.AddStringField(sFieldString := 'a');
    writer.AddStringField(sFieldString := 'b');
    writer.WriteToFile();
    step := 10;

  10:

    IF writer.Busy THEN
      RETURN;
    END_IF

    AssertFalse(Condition := writer.Error, Message := 'file written without an error');
    testFile.Read(FilePath := F_TestFilePath('csv_semicolons.csv'));
